# ─────────────────────────────────────────────────────────────
# تنظیمات هاست لینوکسی (Apache / LiteSpeed، مثل هاست PHP نت‌افراز)
# این فایل موقع «pnpm generate» خودش کنار index.html توی .output/public کپی می‌شه
# و باید توی ریشه‌ی سایت (public_html) آپلود بشه.
# ─────────────────────────────────────────────────────────────

Options -Indexes

# صفحه‌ی ۴۰۴ سایت
ErrorDocument 404 /404.html

# ── هدرهای امنیتی ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # CSP: فقط از خودِ سایت. 'unsafe-inline' برای اسکریپت و استایل لازمه چون Nuxt توی HTML
  # اسکریپت و استایل inline می‌ذاره؛ 'wasm-unsafe-eval' و worker برای دیتابیس محتوا (Nuxt Content).
  # اگه یه روز اسکریپت یا فونت بیرونی (مثل آنالیتیکس) اضافه کردی، دامنه‌اش رو همین‌جا اضافه کن.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # HSTS: بعد از این‌که SSL روی دامنه فعال و درست کار کرد، این خط رو از حالت کامنت دربیار
  # Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# ── کش مرورگر ──
# فایل‌های داخل _nuxt اسمشون با محتوا عوض می‌شه، پس تا یک سال کش می‌شن
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # صفحه‌ها همیشه تازه (تا بعد از آپدیت سایت، کاربر نسخه‌ی قدیمی نبینه)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── فشرده‌سازی ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── فونت و WebP روی هاست‌هایی که این نوع‌ها رو نمی‌شناسن ──
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# ── فایل‌های مخفی (به‌جز .well-known) نباید از بیرون خونده بشن ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # بعد از فعال شدن SSL این دو خط رو از حالت کامنت دربیار تا همه به https بره:
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
